<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal de la aplicación ChefPocket -->
    <style name="Base.Theme.ChefPocket" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chef_primary</item>
        <item name="colorPrimaryVariant">@color/chef_primary_dark</item>
        <item name="colorOnPrimary">@color/chef_text_on_primary</item>
        <item name="colorSecondary">@color/chef_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/chef_background</item>
        <item name="colorSurface">@color/chef_surface</item>
        <item name="android:statusBarColor">@color/chef_primary_dark</item>
    </style>

    <style name="Theme.ChefPocket" parent="Base.Theme.ChefPocket" />

    <!-- Tema estilizado para FirebaseUI Auth heredando de FirebaseUI.DefaultMaterialTheme como el profesor -->
    <style name="Theme.ChefPocket.Login" parent="FirebaseUI.DefaultMaterialTheme">
        <item name="colorPrimary">@color/chef_primary</item>
        <item name="colorPrimaryVariant">@color/chef_primary_dark</item>
        <item name="colorAccent">@color/chef_accent</item>
        <item name="android:statusBarColor">@color/chef_primary_dark</item>
    </style>
</resources>