<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/menu_estadisticas"
        android:src="@drawable/ic_nav_stats"
        app:tint="@color/chef_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/menu_estadisticas"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/chef_text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/estadisticas_vacio"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/chef_text_secondary" />

</LinearLayout>
