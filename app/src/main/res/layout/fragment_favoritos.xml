<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background">

    <!-- Cabecera de la sección -->
    <LinearLayout
        android:id="@+id/ll_cabecera_favoritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_titulo_favoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_seccion_favoritos"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/chef_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitulo_favoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo_seccion_favoritos"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/chef_text_secondary" />
    </LinearLayout>

    <!-- Indicador de carga inicial -->
    <ProgressBar
        android:id="@+id/progress_favoritos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/chef_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_cabecera_favoritos" />

    <!-- RecyclerView de recetas favoritas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_cabecera_favoritos" />

    <!-- Estado vacío cuando no hay recetas guardadas -->
    <LinearLayout
        android:id="@+id/layout_favoritos_vacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_cabecera_favoritos">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/menu_favoritos"
            android:src="@drawable/ic_nav_favorites"
            app:tint="@color/chef_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/favoritos_vacio_titulo"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/chef_text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/favoritos_vacio"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/chef_text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
