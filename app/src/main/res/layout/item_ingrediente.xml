<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Punto decorativo culinario -->
    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_bullet_punto" />

    <!-- Nombre del ingrediente -->
    <TextView
        android:id="@+id/tv_nombre_ingrediente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/chef_text_primary"
        tools:text="Harina de trigo" />

    <!-- Cantidad / Medida -->
    <TextView
        android:id="@+id/tv_medida_ingrediente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/chef_primary"
        android:textStyle="bold"
        tools:text="2 tazas" />

</LinearLayout>

