<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Tarjeta de bienvenida del usuario -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/chef_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_saludo_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/chef_text_primary"
                    android:textStyle="bold"
                    tools:text="¡Hola, Gourmet! 👋" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitulo_home"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/chef_primary"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Estado Sin Conexión (Modo Offline) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/chef_outline"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/modo_offline_titulo"
                    android:src="@drawable/ic_wifi_off"
                    app:tint="@color/chef_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/modo_offline_titulo"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/chef_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/modo_offline_mensaje"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/chef_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reintentar_conexion"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_reintentar"
                    android:textColor="@color/chef_primary"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/chef_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Indicador de carga de la propuesta del día -->
        <LinearLayout
            android:id="@+id/layout_cargando_receta"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/chef_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cargando_receta"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/chef_text_secondary" />

        </LinearLayout>

        <!-- 4. Tarjeta Destacada: ¿No sabes qué cocinar? -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_receta_dia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/chef_outline"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/titulo_receta_dia"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textColor="@color/chef_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitulo_receta_dia"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/chef_text_secondary" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refrescar_receta"
                        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_cambiar_receta"
                        android:textColor="@color/chef_primary"
                        app:icon="@drawable/ic_refresh"
                        app:iconPadding="4dp"
                        app:iconTint="@color/chef_primary" />

                </RelativeLayout>

                <!-- Imagen del plato (Cargada con Glide) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="210dp">

                    <ImageView
                        android:id="@+id/iv_receta_dia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/titulo_receta_dia"
                        android:scaleType="centerCrop"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1A000000" />

                </FrameLayout>

                <!-- Información del plato -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_nombre_receta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/chef_text_primary"
                        android:textStyle="bold"
                        tools:text="Spaghetti Bolognese" />

                    <TextView
                        android:id="@+id/tv_categoria_origen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/chef_primary_dark"
                        android:textStyle="bold"
                        tools:text="Italian · Pasta" />

                    <TextView
                        android:id="@+id/tv_instrucciones_resumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/chef_text_secondary"
                        tools:text="Bring a large pot of water to a boil. Add salt and pasta. Meanwhile in a pan saute onions and minced garlic..." />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Barra de Búsqueda Interactiva -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_buscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@color/chef_surface"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/chef_primary"
            app:boxStrokeWidth="1dp"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/chef_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_buscar_receta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_buscar_receta"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/chef_text_primary"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 6. Filtros Horizontales de Categorías -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_categorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_todas"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/categoria_todas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_pasta"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_pastas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_pollo"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_pollo" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_pescado"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_pescados" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_postres"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_postres" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_vegetariano"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_vegetariano" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_desayunos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_desayunos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_ternera"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_ternera" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- 7. Título de Catálogo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/titulo_catalogo_recetas"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/chef_text_primary"
            android:textStyle="bold" />

        <!-- Indicador de Carga del Catálogo -->
        <ProgressBar
            android:id="@+id/progress_catalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:indeterminateTint="@color/chef_primary"
            android:visibility="gone" />

        <!-- Mensaje de Sin Resultados -->
        <TextView
            android:id="@+id/tv_sin_resultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/sin_resultados_busqueda"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/chef_text_secondary"
            android:visibility="gone" />

        <!-- 8. RecyclerView con las Recetas del Catálogo -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_catalogo_recetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_receta" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
