<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".ui.actividades.LoginActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/chef_surface"
        app:cardCornerRadius="50dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/chef_outline"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_eslogan"
        android:textAppearance="?attr/textAppearanceHeadline4"
        android:textColor="@color/chef_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/login_subtitulo"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textColor="@color/chef_text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/login_descripcion"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/chef_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/chef_primary"
        android:text="@string/btn_iniciar_sesion"
        android:textAppearance="?attr/textAppearanceButton"
        android:textColor="@color/chef_text_on_primary"
        app:cornerRadius="28dp"
        app:elevation="3dp"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconTint="@color/chef_text_on_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/login_pie"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/chef_text_secondary" />

</LinearLayout>
