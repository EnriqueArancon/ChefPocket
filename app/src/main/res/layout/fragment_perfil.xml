<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Avatar Culinario Flotante con Insignia Chef -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="48dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/chef_primary"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@string/menu_perfil"
                android:src="@drawable/ic_chef_logo" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre y Correo del Usuario -->
        <TextView
            android:id="@+id/tv_perfil_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="@color/chef_text_primary"
            android:textStyle="bold"
            tools:text="Enrique Arancón" />

        <TextView
            android:id="@+id/tv_perfil_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/chef_text_secondary"
            tools:text="admin@gmail.com" />

        <!-- Distintivo Culinario de Usuario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/chef_surface_variant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/chef_accent"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/perfil_badge_miembro"
                android:textColor="@color/chef_primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Detalles y Sincronización en la Nube -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/chef_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_seccion_detalles"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/chef_primary"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/chef_divider" />

                <!-- Detalle 1: ID de Usuario -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/chef_primary" />

                    <TextView
                        android:id="@+id/tv_perfil_uid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="@color/chef_text_secondary"
                        tools:text="ID de usuario: abc123xyz" />

                </LinearLayout>

                <!-- Detalle 2: Proveedor de Autenticación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/chef_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/info_proveedor"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="@color/chef_text_secondary" />

                </LinearLayout>

                <!-- Detalle 3: Sincronización en la Nube -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_favorite_filled"
                        app:tint="@color/chef_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/perfil_sincronizacion_activa"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="@color/chef_text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Elegante de Cierre de Sesión (Outlined Pill Style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_sesion_perfil"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/menu_cerrar_sesion"
            android:textAppearance="?attr/textAppearanceButton"
            android:textColor="@color/chef_primary"
            android:textSize="15sp"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/chef_primary"
            app:strokeColor="@color/chef_primary"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

</ScrollView>
