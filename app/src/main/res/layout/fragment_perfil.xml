<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chef_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="48dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/chef_primary"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@string/menu_perfil"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/chef_primary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_perfil_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="@color/chef_text_primary"
            android:textStyle="bold"
            tools:text="PrimeraPrueba" />

        <TextView
            android:id="@+id/tv_perfil_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/chef_text_secondary"
            tools:text="holaaholaa@gmail.com" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/chef_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/chef_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_cuenta"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/chef_primary"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/chef_outline" />

                <TextView
                    android:id="@+id/tv_perfil_uid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="@color/chef_text_secondary"
                    tools:text="ID de usuario: abc123xyz" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/info_proveedor"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="@color/chef_text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_sesion_perfil"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/chef_primary"
            android:text="@string/menu_cerrar_sesion"
            android:textAppearance="?attr/textAppearanceButton"
            android:textColor="@color/chef_text_on_primary"
            app:cornerRadius="27dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/chef_text_on_primary" />

    </LinearLayout>

</ScrollView>
